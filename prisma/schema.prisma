// Prisma schema — PostgreSQL (Neon free tier)
// Rode: npx prisma migrate dev --name init

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

// ---------- NextAuth (Google / GitHub) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]
  plans    MealPlan[]
  settings UserSettings?

  greenAccount  GreenAccount?
  chatMessages  ChatMessage[]
  usageEvents   UsageEvent[]
  labResults    LabResult[]
  payments      Payment[]
  accessLogs    AccessLog[]

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Preferências persistidas do usuário
model UserSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dietaryProfile  String?
  goal            String?
  feasibilityTags FeasibilityTag[]

  greenStyle        String    @default("direct")
  greenCustomStyle  String?
  adultConfirmedAt  DateTime?
  chatTermsAcceptedAt DateTime?
  healthProcessingConsentAt DateTime?
  healthStorageConsentAt    DateTime?

  updatedAt       DateTime @updatedAt
}

// ---------- Domínio nutricional ----------

enum NutrientCategory {
  PROTEIN
  FIBER
  VITAMIN
  MINERAL
  COMPLEX_CARB
  GOOD_FAT
}

enum FeasibilityTag {
  BAIXO_CUSTO
  MEDIO_CUSTO
  ALTO_CUSTO
  FACIL_DE_ACHAR
  ESPECIALIZADO
}

model DietaryProfile {
  id                String  @id @default(cuid())
  slug              String  @unique
  name              String
  shortDesc         String
  longDesc          String
  allowsFish        Boolean @default(false)
  allowsWhiteMeat   Boolean @default(false)
  allowsRedMeat     Boolean @default(false)
  allowsDairy       Boolean @default(false)
  allowsEggs        Boolean @default(false)
  allowsHoney       Boolean @default(false)
  sortOrder         Int     @default(0)

  foodSubs FoodSubstitution[]
  plans    MealPlan[]
}

model Goal {
  id                  String @id @default(cuid())
  slug                String @unique
  name                String
  shortDesc           String
  longDesc            String
  proteinGKgMin       Float
  proteinGKgMax       Float
  calorieAdjustmentPct Float
  fatPctOfCalories    Float  @default(27)
  sortOrder           Int    @default(0)

  plans MealPlan[]
}

model Food {
  id                    String            @id @default(cuid())
  slug                  String            @unique
  name                  String
  category              NutrientCategory
  iconKey               String
  containsAnimalProduct Boolean           @default(false)
  isMeat                Boolean           @default(false)
  isFish                Boolean           @default(false)
  isDairy               Boolean           @default(false)
  isEgg                 Boolean           @default(false)

  // Info nutricional por 100g
  kcal100g      Float
  protein100g   Float
  carbs100g     Float
  fat100g       Float
  fiber100g     Float
  sodium100gMg  Float @default(0)
  sugar100gG    Float @default(0)
  highlightMicros String[]

  feasibilityTags FeasibilityTag[]

  substitutionOf FoodSubstitution[]

  createdAt DateTime @default(now())
}

model FoodSubstitution {
  id               String         @id @default(cuid())
  dietaryProfile   DietaryProfile @relation(fields: [dietaryProfileId], references: [id])
  dietaryProfileId String
  food             Food           @relation(fields: [foodId], references: [id])
  foodId           String
  replacesCategory NutrientCategory
  efficacyRank     Int
  rationale        String

  @@unique([dietaryProfileId, foodId, replacesCategory])
}

// ---------- Plano gerado e salvo ----------

model MealPlan {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dietaryProfile    DietaryProfile @relation(fields: [dietaryProfileId], references: [id])
  dietaryProfileId  String
  goal              Goal           @relation(fields: [goalId], references: [id])
  goalId            String
  daysCount         Int
  optionsPerCategory Json
  feasibilityTags   FeasibilityTag[]
  selectedFoodIds   String[]
  generatedPlan     Json
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}
// ---------- Green (AI chat), wallet and billing ----------

enum UsageKind {
  TRIAL
  CHAT
  ATTACHMENT
}

enum PaymentKind {
  PREMIUM
  CREDITS
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

model GreenAccount {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatBalanceBrl          Decimal   @default(0) @db.Decimal(14, 6)
  attachmentBalanceBrl    Decimal   @default(0) @db.Decimal(14, 6)
  chatCapacityBrl         Decimal   @default(0) @db.Decimal(14, 6)
  attachmentCapacityBrl   Decimal   @default(0) @db.Decimal(14, 6)
  premiumUntil            DateTime?
  trialMessagesUsed       Int       @default(0)
  trialLastMessageAt      DateTime?
  trialClosed             Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model ChatMessage {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             String
  encryptedContent String   @db.Text
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}

model UsageEvent {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind             UsageKind
  model            String
  inputTokens      Int
  outputTokens     Int
  cacheWriteTokens Int       @default(0)
  cacheReadTokens  Int       @default(0)
  apiCalls         Int       @default(1)
  costUsd          Decimal   @db.Decimal(14, 8)
  costBrl          Decimal   @db.Decimal(14, 6)
  usdBrlRate       Decimal   @db.Decimal(10, 4)
  createdAt        DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([kind, createdAt])
}

model LabResult {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedPayload String   @db.Text
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}

model Payment {
  id                     String        @id @default(cuid())
  userId                 String?
  user                   User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind                   PaymentKind
  status                 PaymentStatus @default(PENDING)
  providerPaymentId      String?       @unique
  amountBrl              Decimal       @db.Decimal(12, 2)
  feeBrl                 Decimal       @db.Decimal(12, 4)
  marginBrl              Decimal       @db.Decimal(12, 4)
  chatCreditBrl          Decimal       @default(0) @db.Decimal(14, 6)
  attachmentCreditBrl    Decimal       @default(0) @db.Decimal(14, 6)
  messagesQty            Int           @default(0)
  attachmentsQty         Int           @default(0)
  premiumDays            Int           @default(0)
  refundedAmountBrl      Decimal       @default(0) @db.Decimal(12, 2)
  quote                  Json
  createdAt              DateTime      @default(now())
  approvedAt             DateTime?
  refundedAt             DateTime?

  @@index([userId, createdAt])
}

model ExchangeRate {
  id        String   @id @default(cuid())
  day       String   @unique
  usdBrl    Decimal  @db.Decimal(10, 4)
  source    String
  createdAt DateTime @default(now())
}

model AccessLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ip        String
  route     String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
