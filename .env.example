# Banco de dados (Neon — Postgres gratuito permanente)
# Pooled connection (para a aplicação em runtime):
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dietapp?sslmode=require"
# Direct connection (usada só para migrations):
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dietapp?sslmode=require"

# NextAuth
AUTH_SECRET="gere com: npx auth secret"
AUTH_URL="http://localhost:3000"

# Login com Google (OAuth gratuito) — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Login com GitHub (OAuth gratuito) — https://github.com/settings/developers
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""


# Green (IA) — https://console.anthropic.com
ANTHROPIC_API_KEY=""
GREEN_MODEL="claude-haiku-4-5-20251001"

# Criptografia de mensagens e exames (opcional; se vazio, deriva de AUTH_SECRET)
# gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=""

# Mercado Pago — https://www.mercadopago.com.br/developers/panel/app
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""

# Identificação do vendedor (Decreto 7.962/2013) — aparece no rodapé e nos termos
SELLER_NAME=""
SELLER_DOCUMENT=""
SELLER_EMAIL=""
SELLER_ADDRESS=""

# Preços e limites (valores padrão já servem)
PAYMENT_FEE_RATE="0.0099"
PROFIT_MARGIN_RATE="0.4"
MIN_PAYMENT_BRL="1"
PREMIUM_DAYS="30"
TRIAL_MESSAGES="5"
TRIAL_INTERVAL_HOURS="24"
FREE_MONTHLY_BUDGET_BRL="10"
MAX_ATTACHMENT_MB="5"
USD_BRL_FALLBACK="5.5"
FX_CARD_MARKUP="1.06"

# run
npx prisma migrate dev
npx tsx prisma/seed.ts
npm run dev